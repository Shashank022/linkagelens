<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.shashank022</groupId>
  <artifactId>linkagelens</artifactId>
  <version>0.1.0</version>
  <name>LinkageLens</name>
  <description>Find Java dependency and binary-linkage problems before the JVM does.</description>
  <url>https://github.com/Shashank022/linkagelens</url>
  <licenses><license><name>MIT License</name><url>https://opensource.org/licenses/MIT</url></license></licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifest><mainClass>io.github.shashank022.linkagelens.Main</mainClass></manifest></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
